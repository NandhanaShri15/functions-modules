def prime(n):
    for i in range(2,int(n**0.5+1)):
        if n%i==0:
            return False
    return True
def sum1(n):
        for i in range(2,n):
            if prime(i) and prime(n-i):
                print(n,"=",i,"+",n-i)
                return
        print("Cannot be expressed as sum of two prime num")
