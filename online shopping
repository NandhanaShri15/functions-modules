        t=t+s[i]
        print("Total:",t)
        if t>3000:
            d=t*(10/100)
            t=t-d
            print("After discount:",t)
        else:
            d=0
            t=t+d
            print("After discount:",t)
        g=t*(5/100)
        t=g+t
        print("GST:",g)
        print("Final amount:",t)
