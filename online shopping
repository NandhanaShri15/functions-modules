def getinput(n):
    l=[]
    for i in range(n):
        name=input("Enter item name: ")
        qty=int(input("Enter quantity: "))
        p=int(input("Enter price: "))
        l.append([name,qty,p])
    return l
def subtotal(l,n):
    s=[]
    for i in range(len(l)):
        sub=l[i][1]*l[i][2]
        s.append(sub)
    return s
def total(s,n):
    t=0
